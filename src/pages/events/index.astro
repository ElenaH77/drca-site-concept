---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL;
const events = (await getCollection('events')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Events — DRCA" active="events">
  <p class="eyebrow">DRCA traditions</p>
  <h1>Events</h1>
  <p class="lede">Every DRCA event gets its own page — details, photos, and a registration or tickets
  link when there is one.</p>
  <div class="grid" style="margin-top:1.25rem">
    {events.map(ev => (
      <div class="card">
        <h3>{ev.data.title}</h3>
        <p>{ev.data.blurb}</p>
        <p class="em">{ev.data.cadence}</p>
        <p><a class="btn ghost" href={base + 'events/' + ev.id + '/'}>Event page →</a></p>
      </div>
    ))}
  </div>
</Base>
