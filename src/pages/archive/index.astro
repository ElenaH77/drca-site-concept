---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL;
const items = (await getCollection('pages')).filter(p => p.data.section === 'archive')
  .sort((a, b) => a.data.order - b.data.order);
---
<Base title="Archive — DRCA" active="">
  <p class="eyebrow">The attic</p>
  <h1>Archive</h1>
  <p class="lede">Retired campaign pages and past-project updates, preserved for reference.
  Not linked from the main navigation — but never thrown away.</p>
  <ul class="minlist" style="margin-top:1rem">
    {items.map(p => (
      <li><p><a href={base + 'archive/' + p.id + '/'}>{p.data.title}</a></p></li>
    ))}
  </ul>
</Base>
