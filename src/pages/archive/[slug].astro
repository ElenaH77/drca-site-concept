---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const pages = (await getCollection('pages')).filter(p => p.data.section === 'archive');
  return pages.map(p => ({ params: { slug: p.id }, props: { p } }));
}
const { p } = Astro.props;
const { Content } = await render(p);
const base = import.meta.env.BASE_URL;
---
<Base title={p.data.title + ' — DRCA archive'} active="">
  <p class="eyebrow"><a href={base + 'archive/'}>Archive</a> · retired page, preserved for reference</p>
  <h1>{p.data.title}</h1>
  <div class="prose"><Content /></div>
</Base>
