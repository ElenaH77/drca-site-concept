---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map(p => ({ params: { slug: p.id }, props: { p } }));
}
const { p } = Astro.props;
const { Content } = await render(p);
const base = import.meta.env.BASE_URL;
const fmt = (d) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title={p.data.title + ' — DRCA'} active="news">
  <p class="eyebrow"><a href={base + 'news/'}>News</a> · {fmt(p.data.date)}{p.data.categories ? ' · ' + p.data.categories : ''}</p>
  <h1>{p.data.title}</h1>
  <div class="prose"><Content /></div>
</Base>
