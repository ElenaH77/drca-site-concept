---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL;
const minutes = (await getCollection('news'))
  .filter(e => e.data.categories.includes('Meeting Minutes'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const byYear = {};
for (const m of minutes) {
  const y = m.data.date.getFullYear();
  (byYear[y] ??= []).push(m);
}
const years = Object.keys(byYear).sort((a, b) => b - a);
const fmt = (d) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title="Meeting Minutes — DRCA" active="news">
  <p class="eyebrow">Around the neighborhood</p>
  <h1>News</h1>
  <div class="chips">
    <a class="chip" href={base + 'news/'}>All</a>
    <a class="chip picked" href={base + 'news/minutes/'}>Meeting minutes</a>
  </div>
  <p class="fnote">{minutes.length} sets of minutes, 2013–present, migrated from the current site.</p>
  {years.map(y => (
    <>
      <h2>{y}</h2>
      <ul class="minlist">
        {byYear[y].map(m => (
          <li><span class="d">{fmt(m.data.date)}</span>
            <p><a href={base + 'news/' + m.id + '/'}>{m.data.title}</a></p></li>
        ))}
      </ul>
    </>
  ))}
</Base>
